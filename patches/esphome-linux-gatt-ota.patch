     return false;
 }
 
+bool pb_decode_uint64(pb_buffer_t *buf, uint64_t *value) {
+    return pb_decode_varint(buf, value);
+}
+
+bool pb_decode_bool(pb_buffer_t *buf, bool *value) {
+    uint64_t decoded;
+    if (!pb_decode_varint(buf, &decoded)) {
+        return false;
+    }
+    *value = decoded != 0;
+    return true;
+}
+
+bool pb_decode_bytes(pb_buffer_t *buf, const uint8_t **data, size_t *len) {
+    uint64_t decoded_len;
+    if (!pb_decode_varint(buf, &decoded_len) || decoded_len > SIZE_MAX) {
+        buf->error = true;
+        return false;
+    }
+    if (buf->pos + (size_t)decoded_len > buf->size) {
+        buf->error = true;
+        return false;
+    }
+    *data = buf->data + buf->pos;
+    *len = (size_t)decoded_len;
+    buf->pos += *len;
+    return true;
+}

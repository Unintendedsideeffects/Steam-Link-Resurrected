+#include <vector>
+
+namespace {
+
+constexpr uint16_t OTA_PORT = 8082;
+constexpr size_t MAX_IMAGE_SIZE = 64 * 1024 * 1024;
+constexpr uint8_t MAGIC[] = {0x6c, 0x26, 0xf7, 0x5c, 0x45};
+constexpr uint8_t RESPONSE_OK = 0x00;
+constexpr uint8_t RESPONSE_AUTH_OK = 0x41;
+constexpr uint8_t RESPONSE_UPDATE_PREPARE_OK = 0x42;
+constexpr uint8_t RESPONSE_BIN_MD5_OK = 0x43;
+constexpr uint8_t RESPONSE_RECEIVE_OK = 0x44;
+constexpr uint8_t RESPONSE_UPDATE_END_OK = 0x45;
+constexpr uint8_t RESPONSE_CHUNK_OK = 0x47;
+constexpr uint8_t RESPONSE_REQUEST_SHA256_AUTH = 0x02;
+constexpr uint8_t RESPONSE_HEADER_OK = 0x40;
+constexpr uint8_t RESPONSE_ERROR_MAGIC = 0x80;
+constexpr uint8_t RESPONSE_ERROR_AUTH_INVALID = 0x82;
+constexpr uint8_t RESPONSE_ERROR_UPDATE_PREPARE = 0x81;
+constexpr uint8_t RESPONSE_ERROR_WRITING_FLASH = 0x83;
+constexpr uint8_t RESPONSE_ERROR_MD5_MISMATCH = 0x8b;
+
+class SHA256 {
+public:
+    SHA256() { init(); }
+
+    void init() {
+        state_[0] = 0x6a09e667; state_[1] = 0xbb67ae85;
+        state_[2] = 0x3c6ef372; state_[3] = 0xa54ff53a;
+        state_[4] = 0x510e527f; state_[5] = 0x9b05688c;
+        state_[6] = 0x1f83d9ab; state_[7] = 0x5be0cd19;
+        bit_count_ = 0; block_len_ = 0;
+    }
+
+    void update(const uint8_t *data, size_t len) {
+        bit_count_ += static_cast<uint64_t>(len) * 8;
+        while (len != 0) {
+            size_t take = 64 - block_len_;
+            if (take > len) take = len;
+            std::memcpy(block_ + block_len_, data, take);
+            block_len_ += take; data += take; len -= take;
+            if (block_len_ == 64) { transform(block_); block_len_ = 0; }
+        }
+    }
+
+    std::string finish_hex() {
+        uint64_t bits = bit_count_;
+        block_[block_len_++] = 0x80;
+        if (block_len_ > 56) {
+            while (block_len_ < 64) block_[block_len_++] = 0;
+            transform(block_); block_len_ = 0;
+        }
+        while (block_len_ < 56) block_[block_len_++] = 0;
+        for (int i = 7; i >= 0; --i) block_[block_len_++] = static_cast<uint8_t>(bits >> (i * 8));
+        transform(block_);
+        char out[65];
+        for (unsigned i = 0; i < 8; ++i) {
+            std::snprintf(out + i * 8, 9, "%08x", state_[i]);
+        }
+        out[64] = 0;
+        return out;
+    }
+
+private:
+    uint32_t state_[8]; uint64_t bit_count_; size_t block_len_; uint8_t block_[64];
+    static uint32_t rotr(uint32_t v, unsigned n) { return (v >> n) | (v << (32 - n)); }
+    static uint32_t ch(uint32_t x, uint32_t y, uint32_t z) { return (x & y) ^ (~x & z); }
+    static uint32_t maj(uint32_t x, uint32_t y, uint32_t z) { return (x & y) ^ (x & z) ^ (y & z); }
+    static uint32_t big0(uint32_t x) { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22); }
+    static uint32_t big1(uint32_t x) { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25); }
+    static uint32_t small0(uint32_t x) { return rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3); }
+    static uint32_t small1(uint32_t x) { return rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10); }
+    void transform(const uint8_t *p) {
+        static const uint32_t k[64] = {
+            0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+            0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+            0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+            0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+            0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+            0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+            0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+            0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+        uint32_t w[64];
+        for (unsigned i = 0; i < 16; ++i)
+            w[i] = (static_cast<uint32_t>(p[i*4]) << 24) | (static_cast<uint32_t>(p[i*4+1]) << 16) |
+                   (static_cast<uint32_t>(p[i*4+2]) << 8) | p[i*4+3];
+        for (unsigned i = 16; i < 64; ++i) w[i] = small1(w[i-2]) + w[i-7] + small0(w[i-15]) + w[i-16];
+        uint32_t a=state_[0],b=state_[1],c=state_[2],d=state_[3],e=state_[4],f=state_[5],g=state_[6],h=state_[7];
+        for (unsigned i = 0; i < 64; ++i) { uint32_t t1=h+big1(e)+ch(e,f,g)+k[i]+w[i]; uint32_t t2=big0(a)+maj(a,b,c); h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2; }
+        state_[0]+=a; state_[1]+=b; state_[2]+=c; state_[3]+=d; state_[4]+=e; state_[5]+=f; state_[6]+=g; state_[7]+=h;
+    }
+};
+
+class MD5 {
+public:
+    MD5() { init(); }
+    void init() { a_=0x67452301; b_=0xefcdab89; c_=0x98badcfe; d_=0x10325476; bits_=0; used_=0; }
+    void update(const uint8_t *data, size_t len) {
+        bits_ += static_cast<uint64_t>(len) * 8;
+        while (len) { size_t take = 64 - used_; if (take > len) take = len; std::memcpy(block_ + used_, data, take); used_ += take; data += take; len -= take; if (used_ == 64) { transform(block_); used_ = 0; } }
+    }
+    std::string finish_hex() {
+        uint64_t bits = bits_; block_[used_++] = 0x80;
+        if (used_ > 56) { while (used_ < 64) block_[used_++] = 0; transform(block_); used_ = 0; }
+        while (used_ < 56) block_[used_++] = 0;
+        for (unsigned i = 0; i < 8; ++i) block_[used_++] = static_cast<uint8_t>(bits >> (8 * i));
+        transform(block_);
+        const uint32_t words[4] = {a_, b_, c_, d_}; char out[33];
+        for (unsigned i = 0; i < 4; ++i) for (unsigned j = 0; j < 4; ++j) std::snprintf(out + i * 8 + j * 2, 3, "%02x", (words[i] >> (8 * j)) & 0xff);
+        out[32] = 0; return out;
+    }
+private:
+    uint32_t a_, b_, c_, d_; uint64_t bits_; size_t used_; uint8_t block_[64];
+    static uint32_t rol(uint32_t v, unsigned n) { return (v << n) | (v >> (32 - n)); }
+    static uint32_t f(uint32_t x, uint32_t y, uint32_t z) { return (x & y) | (~x & z); }
+    static uint32_t g(uint32_t x, uint32_t y, uint32_t z) { return (x & z) | (y & ~z); }
+    static uint32_t h(uint32_t x, uint32_t y, uint32_t z) { return x ^ y ^ z; }
+    static uint32_t i(uint32_t x, uint32_t y, uint32_t z) { return y ^ (x | ~z); }
+    void transform(const uint8_t *p) {
+        static const uint32_t k[64] = {
+            0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,
+            0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,
+            0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,
+            0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,
+            0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,
+            0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,
+            0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,
+            0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391};
+        static const unsigned s[64] = {7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21};
+        uint32_t m[16]; for (unsigned j = 0; j < 16; ++j) m[j] = p[j*4] | (p[j*4+1] << 8) | (p[j*4+2] << 16) | (p[j*4+3] << 24);
+        uint32_t a=a_, b=b_, c=c_, d=d_;
+        for (unsigned n = 0; n < 64; ++n) { uint32_t q, idx; if (n < 16) { q=f(b,c,d); idx=n; } else if (n < 32) { q=g(b,c,d); idx=(5*n+1)%16; } else if (n < 48) { q=h(b,c,d); idx=(3*n+5)%16; } else { q=i(b,c,d); idx=(7*n)%16; } uint32_t old=d; d=c; c=b; b=b+rol(a+q+k[n]+m[idx],s[n]); a=old; }
+        a_ += a; b_ += b; c_ += c; d_ += d;
+    }
+};
+
+static bool read_all(int fd, void *data, size_t len) {
+    uint8_t *p = static_cast<uint8_t *>(data);
+    while (len) { ssize_t n = read(fd, p, len); if (n <= 0) return false; p += n; len -= static_cast<size_t>(n); }
+    return true;
+}
+
+static bool write_all(int fd, const void *data, size_t len) {
+    const uint8_t *p = static_cast<const uint8_t *>(data);
+    while (len) { ssize_t n = send(fd, p, len, MSG_NOSIGNAL); if (n <= 0) return false; p += n; len -= static_cast<size_t>(n); }
+    return true;
+}
+
+static bool write_byte(int fd, uint8_t value) { return write_all(fd, &value, 1); }
+
+static bool load_password(std::string *password) {
+    std::ifstream file("/mnt/config/steamlink-ota.conf");
+    std::string line;
+    while (std::getline(file, line)) {
+        const std::string prefix = "STEAMLINK_OTA_PASSWORD=";
+        if (line.compare(0, prefix.size(), prefix) == 0) { *password = line.substr(prefix.size()); return !password->empty(); }
+    }
+    return false;
+}
+
+static bool validate_elf(const char *path) {
+    int fd = open(path, O_RDONLY); if (fd < 0) return false;
+    uint8_t header[20] = {}; bool ok = read_all(fd, header, sizeof(header)); close(fd);
+    return ok && header[0] == 0x7f && header[1] == 'E' && header[2] == 'L' && header[3] == 'F' &&
+           header[4] == 1 && header[5] == 1 && header[18] == 40;
+}
+
+class OtaServer {
+public:
+    OtaServer() : stop_(false), thread_(&OtaServer::run, this) {}
+    ~OtaServer() { stop(); }
+    void stop() { stop_ = true; int fd = server_fd_.load(); if (fd >= 0) shutdown(fd, SHUT_RDWR); if (thread_.joinable()) thread_.join(); }
+
+private:
+    std::atomic<bool> stop_;
+    std::thread thread_;
+    std::atomic<int> server_fd_{-1};
+
+    void run() {
+        std::string password;
+        if (!load_password(&password)) { std::fprintf(stderr, "[ota] disabled: no OTA password configured\n"); return; }
+        int fd = socket(AF_INET, SOCK_STREAM, 0); if (fd < 0) return; server_fd_ = fd;
+        int reuse = 1; setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse));
+        sockaddr_in addr{}; addr.sin_family = AF_INET; addr.sin_addr.s_addr = htonl(INADDR_ANY); addr.sin_port = htons(OTA_PORT);
+        if (bind(fd, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) < 0 || listen(fd, 1) < 0) { close(fd); server_fd_ = -1; return; }
+        std::fprintf(stderr, "[ota] ESPHome OTA v2 listening on %u\n", OTA_PORT);
+        while (!stop_) { int client = accept(fd, nullptr, nullptr); if (client < 0) { if (!stop_) usleep(100000); continue; } handle(client, password); close(client); }
+        close(fd); server_fd_ = -1;
+    }
+
+    void fail(int fd, uint8_t code) { write_byte(fd, code); }
+
+    void handle(int fd, const std::string &password) {
+        uint8_t magic[5]; if (!read_all(fd, magic, sizeof(magic)) || std::memcmp(magic, MAGIC, 5) != 0) { fail(fd, RESPONSE_ERROR_MAGIC); return; }
+        uint8_t version[] = {RESPONSE_OK, 2}; if (!write_all(fd, version, sizeof(version))) return;
+        uint8_t features; if (!read_all(fd, &features, 1) || !write_byte(fd, RESPONSE_HEADER_OK)) return;
+        if (!(features & 0x02)) { fail(fd, RESPONSE_ERROR_AUTH_INVALID); return; }
+
+        static const char hex[] = "0123456789abcdef"; uint8_t random_bytes[32] = {}; int random_fd = open("/dev/urandom", O_RDONLY); bool random_ok = random_fd >= 0 && read_all(random_fd, random_bytes, sizeof(random_bytes)); if (random_fd >= 0) close(random_fd);
+        uint8_t nonce[64]; for (unsigned i = 0; i < 32; ++i) { uint8_t v = random_ok ? random_bytes[i] : static_cast<uint8_t>(i * 73 + 19); nonce[i * 2] = hex[v >> 4]; nonce[i * 2 + 1] = hex[v & 0x0f]; }
+        if (!write_byte(fd, RESPONSE_REQUEST_SHA256_AUTH) || !write_all(fd, nonce, sizeof(nonce))) return;
+        uint8_t auth[128]; if (!read_all(fd, auth, sizeof(auth))) return;
+        SHA256 hasher; hasher.update(reinterpret_cast<const uint8_t *>(password.data()), password.size()); hasher.update(nonce, sizeof(nonce)); hasher.update(auth, 64); std::string expected = hasher.finish_hex();
+        if (std::memcmp(expected.data(), auth + 64, 64) != 0) { fail(fd, RESPONSE_ERROR_AUTH_INVALID); return; }
+        if (!write_byte(fd, RESPONSE_AUTH_OK)) return;
+
+        uint8_t size_buf[4]; if (!read_all(fd, size_buf, 4)) return;
+        uint32_t image_size = (static_cast<uint32_t>(size_buf[0]) << 24) | (static_cast<uint32_t>(size_buf[1]) << 16) | (static_cast<uint32_t>(size_buf[2]) << 8) | size_buf[3];
+        if (image_size == 0 || image_size > MAX_IMAGE_SIZE) { fail(fd, RESPONSE_ERROR_UPDATE_PREPARE); return; }
+        const char *tmp_path = "/mnt/config/ble-proxy/esphome-linux.ota";
+        const char *next_path = "/mnt/config/ble-proxy/esphome-linux.next";
+        int out = open(tmp_path, O_WRONLY | O_CREAT | O_TRUNC, 0700); if (out < 0) { fail(fd, RESPONSE_ERROR_WRITING_FLASH); return; }
+        if (!write_byte(fd, RESPONSE_UPDATE_PREPARE_OK)) { close(out); return; }
+        uint8_t expected_md5[32]; if (!read_all(fd, expected_md5, sizeof(expected_md5))) { close(out); unlink(tmp_path); return; }
+        if (!write_byte(fd, RESPONSE_BIN_MD5_OK)) { close(out); return; }
+        uint8_t buf[8192]; uint32_t total = 0; MD5 md5;
+        while (total < image_size) { size_t want = image_size - total; if (want > sizeof(buf)) want = sizeof(buf); if (!read_all(fd, buf, want) || write(out, buf, want) != static_cast<ssize_t>(want)) { close(out); unlink(tmp_path); fail(fd, RESPONSE_ERROR_WRITING_FLASH); return; } md5.update(buf, want); total += want; if (!write_byte(fd, RESPONSE_CHUNK_OK)) { close(out); unlink(tmp_path); return; } }
+        fsync(out); close(out);
+        std::string actual_md5 = md5.finish_hex(); if (std::memcmp(actual_md5.data(), expected_md5, 32) != 0) { unlink(tmp_path); fail(fd, RESPONSE_ERROR_MD5_MISMATCH); return; }
+        if (!validate_elf(tmp_path) || rename(tmp_path, next_path) != 0) { unlink(tmp_path); fail(fd, RESPONSE_ERROR_UPDATE_PREPARE); return; }
+        if (!write_byte(fd, RESPONSE_RECEIVE_OK) || !write_byte(fd, RESPONSE_UPDATE_END_OK)) return;
+        uint8_t ack; if (read_all(fd, &ack, 1) && ack == RESPONSE_OK) kill(getpid(), SIGTERM);
+    }
+};
+
+static int ota_init(esphome_plugin_context_t *ctx) { ctx->plugin_data = new OtaServer(); return 0; }
+static void ota_cleanup(esphome_plugin_context_t *ctx) { delete static_cast<OtaServer *>(ctx->plugin_data); ctx->plugin_data = nullptr; }
+
+ESPHOME_PLUGIN_REGISTER(ota_plugin, "ESPHomeOTA", "1.0.0", ota_init, ota_cleanup, nullptr, nullptr, nullptr, nullptr);
+
+} // namespace

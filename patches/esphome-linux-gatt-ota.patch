diff --git a/plugins/bluetooth_proxy/gatt_proxy.cpp b/plugins/bluetooth_proxy/gatt_proxy.cpp
new file mode 100644
index 0000000..919c703
--- /dev/null
+++ b/plugins/bluetooth_proxy/gatt_proxy.cpp
@@ -0,0 +1,743 @@
+#include "gatt_proxy.h"
+
+#include <blepp/att.h>
+#include <blepp/blestatemachine.h>
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <sys/select.h>
+#include <unistd.h>
+
+#include <condition_variable>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "../../src/include/esphome_proto.h"
+
+using BLEPP::BLEGATTStateMachine;
+using BLEPP::Characteristic;
+using BLEPP::PDUNotificationOrIndication;
+using BLEPP::PDUReadResponse;
+using BLEPP::PrimaryService;
+using BLEPP::UUID;
+
+namespace {
+
+struct Field {
+    uint32_t number;
+    uint8_t wire_type;
+};
+
+static bool next_field(pb_buffer_t &pb, Field *field) {
+    if (pb.pos >= pb.size) {
+        return false;
+    }
+    uint64_t tag;
+    if (!pb_decode_varint(&pb, &tag) || tag < 8) {
+        pb.error = true;
+        return false;
+    }
+    field->number = static_cast<uint32_t>(tag >> 3);
+    field->wire_type = static_cast<uint8_t>(tag & 7);
+    return field->number != 0;
+}
+
+static bool decode_address(const uint8_t *data, size_t len, uint64_t *address) {
+    pb_buffer_t pb;
+    pb_buffer_init_read(&pb, data, len);
+    Field field;
+    while (next_field(pb, &field)) {
+        if (field.number == 1 && field.wire_type == PB_WIRE_TYPE_VARINT) {
+            return pb_decode_uint64(&pb, address) && !pb.error;
+        }
+        if (!pb_skip_field(&pb, field.wire_type)) {
+            return false;
+        }
+    }
+    return false;
+}
+
+static bool decode_device_request(const uint8_t *data, size_t len,
+                                  uint64_t *address, uint32_t *request_type,
+                                  bool *has_address_type, uint32_t *address_type) {
+    pb_buffer_t pb;
+    pb_buffer_init_read(&pb, data, len);
+    Field field;
+    while (next_field(pb, &field)) {
+        switch (field.number) {
+        case 1:
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint64(&pb, address)) return false;
+            break;
+        case 2:
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint32(&pb, request_type)) return false;
+            break;
+        case 3:
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_bool(&pb, has_address_type)) return false;
+            break;
+        case 4:
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint32(&pb, address_type)) return false;
+            break;
+        default:
+            if (!pb_skip_field(&pb, field.wire_type)) return false;
+            break;
+        }
+    }
+    return !pb.error;
+}
+
+static bool decode_handle_request(const uint8_t *data, size_t len,
+                                  uint64_t *address, uint32_t *handle) {
+    pb_buffer_t pb;
+    pb_buffer_init_read(&pb, data, len);
+    Field field;
+    while (next_field(pb, &field)) {
+        if (field.number == 1) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint64(&pb, address)) return false;
+        } else if (field.number == 2) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint32(&pb, handle)) return false;
+        } else if (!pb_skip_field(&pb, field.wire_type)) {
+            return false;
+        }
+    }
+    return !pb.error;
+}
+
+static bool decode_write_request(const uint8_t *data, size_t len,
+                                 uint32_t data_field, uint64_t *address,
+                                 uint32_t *handle, bool *response,
+                                 std::vector<uint8_t> *value) {
+    pb_buffer_t pb;
+    pb_buffer_init_read(&pb, data, len);
+    Field field;
+    while (next_field(pb, &field)) {
+        if (field.number == 1) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint64(&pb, address)) return false;
+        } else if (field.number == 2) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint32(&pb, handle)) return false;
+        } else if (field.number == 3) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_bool(&pb, response)) return false;
+        } else if (field.number == data_field) {
+            const uint8_t *bytes;
+            size_t bytes_len;
+            if (field.wire_type != PB_WIRE_TYPE_LENGTH || !pb_decode_bytes(&pb, &bytes, &bytes_len)) return false;
+            value->assign(bytes, bytes + bytes_len);
+        } else if (!pb_skip_field(&pb, field.wire_type)) {
+            return false;
+        }
+    }
+    return !pb.error;
+}
+
+static bool decode_notify_request(const uint8_t *data, size_t len,
+                                  uint64_t *address, uint32_t *handle,
+                                  bool *enable) {
+    pb_buffer_t pb;
+    pb_buffer_init_read(&pb, data, len);
+    Field field;
+    while (next_field(pb, &field)) {
+        if (field.number == 1) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint64(&pb, address)) return false;
+        } else if (field.number == 2) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_uint32(&pb, handle)) return false;
+        } else if (field.number == 3) {
+            if (field.wire_type != PB_WIRE_TYPE_VARINT || !pb_decode_bool(&pb, enable)) return false;
+        } else if (!pb_skip_field(&pb, field.wire_type)) {
+            return false;
+        }
+    }
+    return !pb.error;
+}
+
+static std::string address_string(uint64_t address) {
+    char result[18];
+    std::snprintf(result, sizeof(result), "%02X:%02X:%02X:%02X:%02X:%02X",
+                  static_cast<unsigned>((address >> 40) & 0xff),
+                  static_cast<unsigned>((address >> 32) & 0xff),
+                  static_cast<unsigned>((address >> 24) & 0xff),
+                  static_cast<unsigned>((address >> 16) & 0xff),
+                  static_cast<unsigned>((address >> 8) & 0xff),
+                  static_cast<unsigned>(address & 0xff));
+    return result;
+}
+
+static uint64_t little_endian_u64(const uint8_t *data) {
+    uint64_t result = 0;
+    for (unsigned i = 0; i < 8; ++i) {
+        result |= static_cast<uint64_t>(data[i]) << (i * 8);
+    }
+    return result;
+}
+
+static void encode_uuid(pb_buffer_t &pb, uint32_t uuid_field, uint32_t short_uuid_field,
+                        const BLEPP::bt_uuid_t &uuid) {
+    if (uuid.type == BLEPP::BT_UUID16) {
+        pb_encode_uint32(&pb, short_uuid_field, uuid.value.u16);
+        return;
+    }
+    if (uuid.type == BLEPP::BT_UUID32) {
+        pb_encode_uint32(&pb, short_uuid_field, uuid.value.u32);
+        return;
+    }
+    if (uuid.type == BLEPP::BT_UUID128) {
+        pb_encode_uint64(&pb, uuid_field, little_endian_u64(uuid.value.u128.data));
+        pb_encode_uint64(&pb, uuid_field, little_endian_u64(uuid.value.u128.data + 8));
+    }
+}
+
+static size_t encode_connection_response(uint8_t *buffer, size_t size,
+                                          uint64_t address, bool connected,
+                                          uint32_t mtu, int32_t error) {
+    pb_buffer_t pb;
+    pb_buffer_init_write(&pb, buffer, size);
+    pb_encode_uint64(&pb, 1, address);
+    pb_encode_bool(&pb, 2, connected);
+    pb_encode_uint32(&pb, 3, mtu);
+    if (error != 0) pb_encode_uint32(&pb, 4, static_cast<uint32_t>(error));
+    return pb.error ? 0 : pb.pos;
+}
+
+static size_t encode_address_handle(uint8_t *buffer, size_t size,
+                                     uint64_t address, uint32_t handle) {
+    pb_buffer_t pb;
+    pb_buffer_init_write(&pb, buffer, size);
+    pb_encode_uint64(&pb, 1, address);
+    pb_encode_uint32(&pb, 2, handle);
+    return pb.error ? 0 : pb.pos;
+}
+
+static size_t encode_address_handle_data(uint8_t *buffer, size_t size,
+                                          uint64_t address, uint32_t handle,
+                                          const uint8_t *data, size_t data_len) {
+    pb_buffer_t pb;
+    pb_buffer_init_write(&pb, buffer, size);
+    pb_encode_uint64(&pb, 1, address);
+    pb_encode_uint32(&pb, 2, handle);
+    pb_encode_bytes(&pb, 3, data, data_len);
+    return pb.error ? 0 : pb.pos;
+}
+
+static size_t encode_address_only(uint8_t *buffer, size_t size, uint64_t address) {
+    pb_buffer_t pb;
+    pb_buffer_init_write(&pb, buffer, size);
+    pb_encode_uint64(&pb, 1, address);
+    return pb.error ? 0 : pb.pos;
+}
+
+class Connection : public std::enable_shared_from_this<Connection> {
+public:
+    Connection(esphome_plugin_context_t *ctx, int client_id, uint64_t address,
+               uint32_t address_type)
+        : ctx_(ctx), client_id_(client_id), address_(address),
+          address_type_(address_type), gatt_(512) {}
+
+    ~Connection() { stop(); }
+
+    void start() { thread_ = std::thread(&Connection::run, this); }
+
+    void stop() {
+        bool was_stopped = stop_.exchange(true);
+        command_cv_.notify_all();
+        if (!was_stopped && thread_.joinable()) thread_.join();
+        else if (thread_.joinable()) thread_.join();
+    }
+
+    uint64_t address() const { return address_; }
+    int client_id() const { return client_id_; }
+
+    void request_services() {
+        std::lock_guard<std::mutex> lock(command_mutex_);
+        service_requested_ = true;
+        command_cv_.notify_all();
+    }
+
+    void request_read(uint32_t handle) { enqueue(Command{READ, handle, false, {}}); }
+    void request_write(uint32_t handle, bool response, const std::vector<uint8_t> &data) {
+        enqueue(Command{WRITE, handle, response, data});
+    }
+    void request_notify(uint32_t handle, bool enable) { enqueue(Command{NOTIFY, handle, enable, {}}); }
+
+private:
+    enum CommandType { READ, WRITE, NOTIFY };
+    struct Command {
+        CommandType type;
+        uint32_t handle;
+        bool flag;
+        std::vector<uint8_t> data;
+    };
+
+    esphome_plugin_context_t *ctx_;
+    int client_id_;
+    uint64_t address_;
+    uint32_t address_type_;
+    BLEGATTStateMachine gatt_;
+    std::thread thread_;
+    std::atomic<bool> stop_{false};
+    std::mutex command_mutex_;
+    std::condition_variable command_cv_;
+    std::deque<Command> commands_;
+    bool service_requested_ = false;
+    bool services_ready_ = false;
+    uint32_t pending_handle_ = 0;
+    bool pending_notify_ = false;
+    std::atomic<bool> connected_{false};
+    std::atomic<bool> disconnected_reported_{false};
+
+    void enqueue(Command command) {
+        std::lock_guard<std::mutex> lock(command_mutex_);
+        commands_.push_back(std::move(command));
+        command_cv_.notify_all();
+    }
+
+    void send(uint32_t type, const uint8_t *data, size_t len) {
+        esphome_plugin_send_message_to_client(ctx_, client_id_, type, data, len);
+    }
+
+    void send_connection(bool connected, int32_t error = 0) {
+        if (!connected) {
+            bool expected = false;
+            if (!disconnected_reported_.compare_exchange_strong(expected, true)) return;
+        }
+        uint8_t buffer[64];
+        size_t len = encode_connection_response(buffer, sizeof(buffer), address_, connected, 23, error);
+        if (len) send(ESPHOME_MSG_BLUETOOTH_DEVICE_CONNECTION_RESPONSE, buffer, len);
+    }
+
+    void send_error(uint32_t handle, int32_t error) {
+        uint8_t buffer[64];
+        pb_buffer_t pb;
+        pb_buffer_init_write(&pb, buffer, sizeof(buffer));
+        pb_encode_uint64(&pb, 1, address_);
+        pb_encode_uint32(&pb, 2, handle);
+        pb_encode_uint32(&pb, 3, static_cast<uint32_t>(error));
+        if (!pb.error) send(ESPHOME_MSG_BLUETOOTH_GATT_ERROR_RESPONSE, buffer, pb.pos);
+    }
+
+    void send_services() {
+        std::vector<uint8_t> buffer(8192);
+        pb_buffer_t outer;
+        pb_buffer_init_write(&outer, buffer.data(), buffer.size());
+        pb_encode_uint64(&outer, 1, address_);
+
+        for (const PrimaryService &service : gatt_.primary_services) {
+            uint8_t service_buffer[4096];
+            pb_buffer_t service_pb;
+            pb_buffer_init_write(&service_pb, service_buffer, sizeof(service_buffer));
+            encode_uuid(service_pb, 1, 4, service.uuid);
+            pb_encode_uint32(&service_pb, 2, service.start_handle);
+
+            for (const Characteristic &characteristic : service.characteristics) {
+                uint8_t characteristic_buffer[1024];
+                pb_buffer_t characteristic_pb;
+                pb_buffer_init_write(&characteristic_pb, characteristic_buffer,
+                                     sizeof(characteristic_buffer));
+                encode_uuid(characteristic_pb, 1, 5, characteristic.uuid);
+                pb_encode_uint32(&characteristic_pb, 2, characteristic.value_handle);
+                uint32_t properties = 0;
+                if (characteristic.broadcast) properties |= 0x01;
+                if (characteristic.read) properties |= 0x02;
+                if (characteristic.write_without_response) properties |= 0x04;
+                if (characteristic.write) properties |= 0x08;
+                if (characteristic.notify) properties |= 0x10;
+                if (characteristic.indicate) properties |= 0x20;
+                if (characteristic.authenticated_write) properties |= 0x40;
+                if (characteristic.extended) properties |= 0x80;
+                pb_encode_uint32(&characteristic_pb, 3, properties);
+                if (characteristic.client_characteric_configuration_handle != 0) {
+                    uint8_t descriptor_buffer[64];
+                    pb_buffer_t descriptor_pb;
+                    pb_buffer_init_write(&descriptor_pb, descriptor_buffer,
+                                         sizeof(descriptor_buffer));
+                    BLEPP::UUID cccd(0x2902);
+                    encode_uuid(descriptor_pb, 1, 3, cccd);
+                    pb_encode_uint32(&descriptor_pb, 2,
+                                     characteristic.client_characteric_configuration_handle);
+                    if (!descriptor_pb.error) {
+                        pb_encode_bytes(&characteristic_pb, 4, descriptor_buffer,
+                                        descriptor_pb.pos);
+                    }
+                }
+                if (!characteristic_pb.error) {
+                    pb_encode_bytes(&service_pb, 3, characteristic_buffer,
+                                    characteristic_pb.pos);
+                }
+            }
+            if (service_pb.error) {
+                send_error(0, EMSGSIZE);
+                return;
+            }
+            pb_encode_bytes(&outer, 2, service_buffer, service_pb.pos);
+        }
+
+        if (!outer.error) send(ESPHOME_MSG_BLUETOOTH_GATT_GET_SERVICES_RESPONSE,
+                               buffer.data(), outer.pos);
+        uint8_t done[32];
+        size_t done_len = encode_address_only(done, sizeof(done), address_);
+        if (done_len) send(ESPHOME_MSG_BLUETOOTH_GATT_GET_SERVICES_DONE_RESPONSE,
+                           done, done_len);
+    }
+
+    void on_services_ready() {
+        services_ready_ = true;
+        bool should_send = false;
+        {
+            std::lock_guard<std::mutex> lock(command_mutex_);
+            should_send = service_requested_;
+            service_requested_ = false;
+        }
+        if (should_send) send_services();
+    }
+
+    Characteristic *find_characteristic(uint32_t handle) {
+        for (auto &service : gatt_.primary_services) {
+            for (auto &characteristic : service.characteristics) {
+                if (characteristic.value_handle == handle) return &characteristic;
+            }
+        }
+        return nullptr;
+    }
+
+    void process_command(const Command &command) {
+        if (!services_ready_ || !gatt_.is_idle()) {
+            std::lock_guard<std::mutex> lock(command_mutex_);
+            commands_.push_front(command);
+            return;
+        }
+        pending_handle_ = command.handle;
+        pending_notify_ = false;
+        try {
+            if (command.type == READ) {
+                gatt_.send_read_request(static_cast<uint16_t>(command.handle));
+            } else if (command.type == WRITE) {
+                if (command.flag) {
+                    gatt_.send_write_request(static_cast<uint16_t>(command.handle),
+                                             command.data.data(), static_cast<int>(command.data.size()));
+                } else {
+                    gatt_.send_write_command(static_cast<uint16_t>(command.handle),
+                                             command.data.data(), static_cast<int>(command.data.size()));
+                    uint8_t response[32];
+                    size_t response_len = encode_address_handle(response, sizeof(response),
+                                                                  address_, command.handle);
+                    if (response_len) send(ESPHOME_MSG_BLUETOOTH_GATT_WRITE_RESPONSE,
+                                           response, response_len);
+                    pending_handle_ = 0;
+                }
+            } else if (command.type == NOTIFY) {
+                Characteristic *characteristic = find_characteristic(command.handle);
+                if (!characteristic || !characteristic->client_characteric_configuration_handle) {
+                    send_error(command.handle, EINVAL);
+                    pending_handle_ = 0;
+                    return;
+                }
+                pending_notify_ = true;
+                gatt_.set_notify_and_indicate(*characteristic, command.flag,
+                                              false, BLEPP::WriteType::Request);
+            }
+        } catch (const std::exception &error) {
+            std::fprintf(stderr, "[bluetooth_proxy] GATT command failed: %s\n", error.what());
+            send_error(command.handle, EIO);
+            pending_handle_ = 0;
+            pending_notify_ = false;
+        }
+    }
+
+    void run() {
+        bool connected_once = false;
+        /* Install the standard discovery chain explicitly so the proxy can add
+         * its connection and operation callbacks without overwriting it. */
+        gatt_.cb_connected = [this, &connected_once]() {
+            connected_once = true;
+            connected_.store(true);
+            send_connection(true);
+            gatt_.read_primary_services();
+        };
+        gatt_.cb_services_read = [this]() { gatt_.find_all_characteristics(); };
+        gatt_.cb_find_characteristics = [this]() {
+            gatt_.get_client_characteristic_configuration();
+        };
+        gatt_.cb_get_client_characteristic_configuration = [this]() {
+            on_services_ready();
+        };
+        gatt_.cb_disconnected = [this](BLEGATTStateMachine::Disconnect) {
+            /* Some BlueZ/libblepp failure paths pass an invalid temporary
+             * reason reference. Keep the proxy alive and report a generic
+             * transport error rather than dereferencing it. */
+            connected_.store(false);
+        };
+        gatt_.cb_read = [this](Characteristic &characteristic, const PDUReadResponse &response) {
+            auto value = response.value();
+            uint8_t buffer[8192];
+            size_t len = encode_address_handle_data(buffer, sizeof(buffer), address_,
+                                                    characteristic.value_handle,
+                                                    value.first, static_cast<size_t>(value.second - value.first));
+            if (len) send(ESPHOME_MSG_BLUETOOTH_GATT_READ_RESPONSE, buffer, len);
+            pending_handle_ = 0;
+        };
+        gatt_.cb_notify_or_indicate = [this](Characteristic &characteristic,
+                                             const PDUNotificationOrIndication &notification) {
+            auto value = notification.value();
+            uint8_t buffer[8192];
+            size_t len = encode_address_handle_data(buffer, sizeof(buffer), address_,
+                                                    characteristic.value_handle,
+                                                    value.first, static_cast<size_t>(value.second - value.first));
+            if (len) send(ESPHOME_MSG_BLUETOOTH_GATT_NOTIFY_DATA_RESPONSE, buffer, len);
+        };
+        gatt_.cb_write_response = [this]() {
+            uint8_t buffer[32];
+            size_t len = encode_address_handle(buffer, sizeof(buffer), address_, pending_handle_);
+            if (len) send(pending_notify_ ? ESPHOME_MSG_BLUETOOTH_GATT_NOTIFY_RESPONSE :
+                         ESPHOME_MSG_BLUETOOTH_GATT_WRITE_RESPONSE, buffer, len);
+            pending_handle_ = 0;
+            pending_notify_ = false;
+        };
+
+        for (int attempt = 0; attempt < 2 && !stop_; ++attempt) {
+            connected_.store(false);
+            bool public_address = (attempt == 0 ? address_type_ : (address_type_ == 0 ? 1U : 0U)) == 0;
+            std::fprintf(stderr, "[bluetooth_proxy] GATT connect attempt %d using %s address\n",
+                         attempt + 1, public_address ? "public" : "random");
+            try {
+                gatt_.connect(address_string(address_), false, public_address);
+            } catch (const std::exception &error) {
+                std::fprintf(stderr, "[bluetooth_proxy] GATT connect attempt %d failed: %s\n",
+                             attempt + 1, error.what());
+                gatt_.close();
+                continue;
+            }
+
+        while (!stop_) {
+            if (gatt_.socket() < 0) break;
+
+            Command command;
+            bool have_command = false;
+            {
+                std::lock_guard<std::mutex> lock(command_mutex_);
+                if (services_ready_ && !commands_.empty()) {
+                    command = std::move(commands_.front());
+                    commands_.pop_front();
+                    have_command = true;
+                }
+            }
+            if (have_command) process_command(command);
+
+            fd_set read_set;
+            fd_set write_set;
+            FD_ZERO(&read_set);
+            FD_ZERO(&write_set);
+            int fd = gatt_.socket();
+            if (fd < 0 || fd >= FD_SETSIZE) {
+                std::fprintf(stderr, "[bluetooth_proxy] GATT socket fd out of range: %d\\n", fd);
+                break;
+            }
+            FD_SET(fd, &read_set);
+            if (gatt_.wait_on_write()) FD_SET(fd, &write_set);
+            timeval timeout{0, 100000};
+            int result = select(fd + 1, &read_set, &write_set, nullptr, &timeout);
+            if (result < 0) {
+                if (errno == EINTR) continue;
+                break;
+            }
+            try {
+                bool write_ready = FD_ISSET(fd, &write_set);
+                if (write_ready) gatt_.write_and_process_next();
+                /* A nonblocking connect can mark the socket readable and
+                 * writable in the same select result. Do not try to read
+                 * before the connect callback has issued the first ATT
+                 * request; an EAGAIN here is treated as a fatal BLE error by
+                 * the legacy libblepp receive path. */
+                if (!write_ready && gatt_.socket() == fd && FD_ISSET(fd, &read_set)) {
+                    gatt_.read_and_process_next();
+                }
+            } catch (const std::exception &error) {
+                std::fprintf(stderr, "[bluetooth_proxy] GATT event loop failed: %s\n", error.what());
+                break;
+            }
+        }
+            gatt_.close();
+            if (connected_once || stop_) break;
+            if (attempt == 0) usleep(100000);
+        }
+        send_connection(false, EIO);
+    }
+};
+
+class Manager {
+public:
+    explicit Manager(esphome_plugin_context_t *ctx) : ctx_(ctx) {}
+    ~Manager() { stop_all(); }
+
+    int handle(int client_id, uint32_t msg_type, const uint8_t *data, size_t len) {
+        if (msg_type == ESPHOME_MSG_BLUETOOTH_DEVICE_REQUEST) {
+            return device_request(client_id, data, len);
+        }
+        if (msg_type == ESPHOME_MSG_BLUETOOTH_GATT_GET_SERVICES_REQUEST) {
+            return services_request(data, len);
+        }
+        if (msg_type == ESPHOME_MSG_BLUETOOTH_GATT_READ_REQUEST ||
+            msg_type == ESPHOME_MSG_BLUETOOTH_GATT_READ_DESCRIPTOR_REQUEST) {
+            return read_request(data, len);
+        }
+        if (msg_type == ESPHOME_MSG_BLUETOOTH_GATT_WRITE_REQUEST ||
+            msg_type == ESPHOME_MSG_BLUETOOTH_GATT_WRITE_DESCRIPTOR_REQUEST) {
+            return write_request(data, len, msg_type == ESPHOME_MSG_BLUETOOTH_GATT_WRITE_DESCRIPTOR_REQUEST);
+        }
+        if (msg_type == ESPHOME_MSG_BLUETOOTH_GATT_NOTIFY_REQUEST) {
+            return notify_request(data, len);
+        }
+        if (msg_type == ESPHOME_MSG_SUBSCRIBE_BLUETOOTH_CONNECTIONS_FREE_REQUEST) {
+            return free_request(client_id);
+        }
+        return -1;
+    }
+
+private:
+    esphome_plugin_context_t *ctx_;
+    std::mutex mutex_;
+    std::map<uint64_t, std::shared_ptr<Connection>> connections_;
+    static constexpr size_t MAX_CONNECTIONS = 3;
+
+    int device_request(int client_id, const uint8_t *data, size_t len) {
+        uint64_t address = 0;
+        uint32_t request_type = 0;
+        bool has_address_type = false;
+        uint32_t address_type = 0;
+        if (!decode_device_request(data, len, &address, &request_type,
+                                   &has_address_type, &address_type)) return -1;
+        if (request_type == 1) {
+            std::shared_ptr<Connection> connection;
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                auto it = connections_.find(address);
+                if (it != connections_.end()) {
+                    connection = it->second;
+                    connections_.erase(it);
+                }
+            }
+            if (connection) connection->stop();
+            return 0;
+        }
+        if (request_type != 4 && request_type != 5 && request_type != 0) {
+            return -1;
+        }
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (connections_.count(address)) return 0;
+        if (connections_.size() >= MAX_CONNECTIONS) return 0;
+        if (!has_address_type) address_type = 0;
+        auto connection = std::make_shared<Connection>(ctx_, client_id, address, address_type);
+        connections_[address] = connection;
+        connection->start();
+        return 0;
+    }
+
+    std::shared_ptr<Connection> find(uint64_t address) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        auto it = connections_.find(address);
+        return it == connections_.end() ? nullptr : it->second;
+    }
+
+    int services_request(const uint8_t *data, size_t len) {
+        uint64_t address;
+        if (!decode_address(data, len, &address)) return -1;
+        auto connection = find(address);
+        if (!connection) return 0;
+        connection->request_services();
+        return 0;
+    }
+
+    int read_request(const uint8_t *data, size_t len) {
+        uint64_t address;
+        uint32_t handle = 0;
+        if (!decode_handle_request(data, len, &address, &handle)) return -1;
+        auto connection = find(address);
+        if (!connection) return 0;
+        connection->request_read(handle);
+        return 0;
+    }
+
+    int write_request(const uint8_t *data, size_t len, bool descriptor) {
+        uint64_t address;
+        uint32_t handle = 0;
+        bool requested_response = descriptor;
+        std::vector<uint8_t> value;
+        if (!decode_write_request(data, len, descriptor ? 3 : 4, &address, &handle,
+                                  &requested_response, &value)) return -1;
+        auto connection = find(address);
+        if (!connection) return 0;
+        connection->request_write(handle, requested_response, value);
+        return 0;
+    }
+
+    int notify_request(const uint8_t *data, size_t len) {
+        uint64_t address;
+        uint32_t handle = 0;
+        bool enable = false;
+        if (!decode_notify_request(data, len, &address, &handle, &enable)) return -1;
+        auto connection = find(address);
+        if (!connection) return 0;
+        connection->request_notify(handle, enable);
+        return 0;
+    }
+
+    int free_request(int client_id) {
+        uint8_t buffer[256];
+        pb_buffer_t pb;
+        pb_buffer_init_write(&pb, buffer, sizeof(buffer));
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            pb_encode_uint32(&pb, 1, static_cast<uint32_t>(MAX_CONNECTIONS - connections_.size()));
+            pb_encode_uint32(&pb, 2, static_cast<uint32_t>(MAX_CONNECTIONS));
+            for (const auto &entry : connections_) pb_encode_uint64(&pb, 3, entry.first);
+        }
+        if (!pb.error) esphome_plugin_send_message_to_client(
+            ctx_, client_id, ESPHOME_MSG_BLUETOOTH_CONNECTIONS_FREE_RESPONSE, buffer, pb.pos);
+        return 0;
+    }
+
+    void stop_all() {
+        std::map<uint64_t, std::shared_ptr<Connection>> connections;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            connections.swap(connections_);
+        }
+        for (auto &entry : connections) entry.second->stop();
+    }
+};
+
+std::mutex managers_mutex;
+std::map<esphome_plugin_context_t *, std::unique_ptr<Manager>> managers;
+
+} // namespace
+
+extern "C" int gatt_proxy_init(esphome_plugin_context_t *ctx) {
+    std::lock_guard<std::mutex> lock(managers_mutex);
+    managers[ctx] = std::unique_ptr<Manager>(new Manager(ctx));
+    return 0;
+}
+
+extern "C" void gatt_proxy_cleanup(esphome_plugin_context_t *ctx) {
+    std::unique_ptr<Manager> manager;
+    {
+        std::lock_guard<std::mutex> lock(managers_mutex);
+        auto it = managers.find(ctx);
+        if (it == managers.end()) return;
+        manager = std::move(it->second);
+        managers.erase(it);
+    }
+}
+
+extern "C" int gatt_proxy_handle_message(esphome_plugin_context_t *ctx,
+                                           int client_id, uint32_t msg_type,
+                                           const uint8_t *data, size_t len) {
+    std::lock_guard<std::mutex> lock(managers_mutex);
+    auto it = managers.find(ctx);
+    if (it == managers.end()) return -1;
+    return it->second->handle(client_id, msg_type, data, len);
+}

+void bluetooth_proxy_pause_scanning(esphome_plugin_context_t *ctx) {
+    bluetooth_proxy_state_t *state = (bluetooth_proxy_state_t *)ctx->plugin_data;
+    if (!state) return;
+    state->gatt_pause_count++;
+    if (state->gatt_pause_count == 1 && state->subscribed) {
+        if (ble_scanner_stop(state->scanner) < 0) {
+            fprintf(stderr, "[bluetooth_proxy] Failed to pause BLE scanning for GATT\n");
+        } else {
+            state->subscribed = false;
+        }
+    }
+}
+
+void bluetooth_proxy_resume_scanning(esphome_plugin_context_t *ctx) {
+    bluetooth_proxy_state_t *state = (bluetooth_proxy_state_t *)ctx->plugin_data;
+    if (!state || state->gatt_pause_count == 0) return;
+    state->gatt_pause_count--;
+    if (state->gatt_pause_count == 0 && state->subscriber_count > 0 &&
+        !state->subscribed && state->ble_scanning_enabled) {
+        if (ble_scanner_start(state->scanner) < 0) {
+            fprintf(stderr, "[bluetooth_proxy] Failed to resume BLE scanning after GATT\n");
+        } else {
+            state->subscribed = true;
+        }
+    }
+}
